IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=7

# Discord webhooks for notifications (notifications.enabled must also be
# true in config.yaml). Create one per channel in Discord's channel
# settings: Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
# Any of the three can be left blank to skip that channel.
DISCORD_WEBHOOK_KILL_SWITCH=
DISCORD_WEBHOOK_LIMITS=
DISCORD_WEBHOOK_TRADE_ACTIVITY=
